{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {".read": "auth != null && auth.uid === $uid", ".write": false}
    },
    "users": {
      "$uid": {".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)", ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"}
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !root.child('users').child(auth.uid).child('status').val() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('requestedNumber').isNumber() && newData.child('requestedNumber').val() > 0 && newData.child('requestedNumber').val() < 10000 && newData.child('email').val() === auth.token.email))"
      }
    },
    "members": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$number": {".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.child('uid').val() === auth.uid && root.child('users').child(auth.uid).child('memberNumber').val() === $number && root.child('users').child(auth.uid).child('status').val() === 'approved'))"}
    }
  }
}
